{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AI4RA/prompt-library/components/rfa-checklist-field-mapper/schema.json",
  "title": "RFA Checklist Field Mapper \u2014 Output",
  "description": "Passages copied verbatim from a free-form RFA checklist, sorted into the 28 RFA Plan B gold fields. Every value is a list of strings; an empty list means the checklist gives nothing for that field. Verbatim copying is checked by the caller, not by this schema.",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rfa_number",
    "rfa_title",
    "sponsor_name",
    "program_code",
    "announcement_url",
    "opportunity_number",
    "cfda_number",
    "funding_instrument_type",
    "dates_and_deadlines",
    "eligible_institutions",
    "eligible_individuals",
    "award_duration",
    "amount_per_award",
    "number_of_awards",
    "anticipated_award_date",
    "submission_details",
    "formatting_requirements",
    "required_components",
    "optional_components",
    "funding_limits",
    "cost_sharing_status",
    "cost_sharing_details",
    "fa_policy",
    "personnel_effort",
    "other_considerations",
    "allowable_costs",
    "unallowable_costs",
    "special_requirements"
  ],
  "properties": {
    "rfa_number": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rfa_title": {
